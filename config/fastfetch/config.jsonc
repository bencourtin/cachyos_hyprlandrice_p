// ~/.config/fastfetch/config.jsonc
// Greeting for kitty (run by fish_greeting -> see ~/.config/fish/config.fish).
//
// Custom logo: drop an image at  ~/.config/fastfetch/logo.png
//              (or a still frame; a .gif shows only its first frame here).
// If that file is missing, the fish greeting falls back to the small ASCII logo.
//
// Key colours use *named terminal colours* on purpose: the kitty palette is
// generated by matugen from the wallpaper, so the greeting recolours itself
// with the rest of the rice. No extra matugen template needed.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/logo.png",
    "width": 32,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },

  "display": {
    "separator": "  ",
    "color": { "separator": "white" }
  },

  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator", "string": "─" },

    { "type": "os",       "key": "  os  ", "keyColor": "blue" },
    { "type": "kernel",   "key": "  ker ", "keyColor": "blue" },
    { "type": "packages", "key": "  pkg ", "keyColor": "cyan" },
    { "type": "uptime",   "key": "  up  ", "keyColor": "cyan" },

    { "type": "break" },
    { "type": "wm",       "key": "  wm  ", "keyColor": "magenta" },
    { "type": "terminal", "key": "  term", "keyColor": "magenta" },
    { "type": "shell",    "key": "  sh  ", "keyColor": "magenta" },

    { "type": "break" },
    { "type": "cpu",      "key": "  cpu ", "keyColor": "green" },
    { "type": "gpu",      "key": "  gpu ", "keyColor": "green" },
    { "type": "memory",   "key": "  ram ", "keyColor": "yellow" },
    { "type": "disk",     "key": "  ssd ", "keyColor": "yellow", "folders": "/" },
    { "type": "display",  "key": "  res ", "keyColor": "red" },
    { "type": "localip",  "key": "  ip  ", "keyColor": "red", "showIpv6": false },

    "break",
    { "type": "colors", "symbol": "circle" },
    "break"
  ]
}
